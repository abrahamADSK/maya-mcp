# ============================================================
# maya-mcp — Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# .env is git-ignored and never committed.
# ============================================================

# ── Vision3D GPU server ───────────────────────────────────────
# Vision3D runs as a standalone server on the GPU machine.
# See the vision3d repo for setup: https://github.com/abrahamADSK/vision3d
#
# GPU_API_URL     — base URL of the Vision3D server (HTTP, direct)
# GPU_API_KEY     — API key (leave empty for open access on LAN)
# GPU_VERIFY_TLS  — verify TLS certificates for https targets (default: true).
#                   Ignored for plain-http LAN URLs. Set to false only to opt
#                   out for a self-signed https endpoint.

GPU_API_URL=http://your-gpu-host:8000
GPU_API_KEY=                              # leave empty if open access on LAN
# GPU_VERIFY_TLS=true

# ── Local project ────────────────────────────────────────────
# Absolute path to this repository on your local machine
PROJECT_DIR=/path/to/maya-mcp

# Output subdirectory within reference/3d_output/ (default: 0)
# OUTPUT_SUBDIR=0

# Default reference image (override with --image flag)
# REFERENCE_IMAGE=/path/to/my_reference.jpg

# ── Maya MCP server (src/maya_mcp/) ─────────────────────────
# MAYA_HOST=localhost
# MAYA_PORT=8100

# ── Audit log (opt-in, OFF by default) ──────────────────────
# MAYA_AUDIT_LOG  — when set to 1/true/yes/on, append a durable, append-only
#                   JSONL record of every tool execution (mutations,
#                   execute_python, and safety/AST-blocked attempts) to
#                   src/maya_mcp/logs/audit.jsonl (5 MB + .1 rotation, git-ignored).
#                   Unset/empty = no-op: no file, no perf/disk/privacy impact.
#                   Read it with jq/grep — there is no MCP tool for it.
#                   execute_python code is truncated (~2000 chars) + SHA-256'd;
#                   Maya result payloads are never stored.
# MAYA_AUDIT_LOG=1
