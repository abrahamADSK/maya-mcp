# ── Environment & secrets ────────────────────────────────────
.env
*.env.local

# ── Per-user runtime config ──────────────────────────────────
# config.json holds machine-local settings (backend, model choice,
# Ollama URLs, etc.). Only config.example.json is committed. The
# live config.json is populated by each user/machine and must
# never enter the repo. Vision3D endpoints are NOT stored in
# config.json — they are asked per-session at runtime.
src/maya_mcp/config.json

# ── Pipeline outputs ─────────────────────────────────────────
reference/3d_output/
renders/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv*/
*.egg-info/
dist/
build/

# ── macOS ────────────────────────────────────────────────────
.DS_Store
.AppleDouble

# ── Cowork skill bundles ─────────────────────────────────────
*.skill

# ── Temp scripts ─────────────────────────────────────────────
*.command

# ── Claude / RAG (generated) ─────────────────────────────────
.claude/
.mcp.json

# ── Editor ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Maya ─────────────────────────────────────────────────────
*.ma
*.mb
*.mayaSwatches/

# ── Large model files (weights should never be committed) ────
*.safetensors
*.ckpt
*.bin
hf_models/
# Telemetry + durable audit log (best-effort JSONL under src/maya_mcp/logs/).
# `logs/` already matches any logs dir; the explicit paths document that the
# opt-in audit log (MAYA_AUDIT_LOG=1) and its rotated .1 must never be committed.
logs/
src/maya_mcp/logs/audit.jsonl
src/maya_mcp/logs/audit.jsonl.1
src/maya_mcp/rag/index/
src/maya_mcp/rag/corpus.json
# learn_pattern staging file: non-trusted models write candidate code here for
# review. Never commit it — `git add -A` would otherwise fold arbitrary
# model-authored code into history.
src/maya_mcp/rag/candidates.json

# Coverage artifact from pytest-cov
.coverage

# ── Graphify (generated knowledge graph) ─────────────────────
# graphify-out/ holds the persistent knowledge-graph artifacts
# produced by the /graphify skill. Generated locally, never
# committed.
src/graphify-out/

# ── Console improvement backlog ──────────────────────────────
# Auto-captured by the read-only console worker (console._readonly.
# capture_suggestions). Local-only: picked up in dev sessions / PRs,
# not tracked, keeps the working tree clean during recordings.
CONSOLE_IMPROVEMENTS.md
